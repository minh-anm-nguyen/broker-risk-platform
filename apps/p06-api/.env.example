# Risk Reporting API configuration. Copy to .env for local work.
#
# Every value is read with the RISK_API_ prefix. The bundled development key
# material only works when RISK_API_ENVIRONMENT is local or test: a staging or
# production instance that does not supply its own keys refuses to start.

# ---------------------------------------------------------------- environment
RISK_API_ENVIRONMENT=local
RISK_API_LOG_LEVEL=INFO
RISK_API_SERVICE_NAME=risk-reporting-api
RISK_API_API_BASE_PATH=/api/v1

# ------------------------------------------------------------------- identity
# Replace both of these outside local/test. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
RISK_API_JWT_ISSUER=https://issuer.local.test/risk
RISK_API_JWT_AUDIENCE=risk-reporting-api
# JSON object of kid -> secret. Keep real values out of source control.
# RISK_API_JWT_KEYS={"prod-2026-10":"REPLACE_ME"}
RISK_API_JWT_ALLOWED_ALGORITHMS=["HS256"]
RISK_API_JWT_CLOCK_SKEW_SECONDS=30
RISK_API_JWT_MAX_LIFETIME_SECONDS=3600

# --------------------------------------------------------------- report policy
# true means a partial report must be asked for explicitly. Leave it true.
RISK_API_STRICT_COMPOSITE_DEFAULT=true
RISK_API_REPORTING_CURRENCY=USD
RISK_API_RISK_POLICY_VERSION=risk-policy-v1
RISK_API_SYMBOL_CATALOG_VERSION=sim-usd-fx-v1
# Letting a client pin a historical epoch needs its own tested policy first.
RISK_API_ALLOW_PINNED_EPOCH_REQUESTS=false

# --------------------------------------------------------------------- limits
RISK_API_MAX_BODY_BYTES=65536
RISK_API_MAX_URL_CHARS=2048
RISK_API_MAX_QUERY_CHARS=1024
RISK_API_MAX_JSON_DEPTH=12
RISK_API_MAX_ACCOUNTS_PER_REQUEST=100
RISK_API_MAX_POSITIONS_PAGE=100
RISK_API_DEFAULT_POSITIONS_PAGE=50
RISK_API_MAX_AGGREGATE_SYMBOLS=200
RISK_API_MAX_PNL_WINDOW_DAYS=31
RISK_API_DEFAULT_REALIZED_WINDOW_DAYS=31
RISK_API_MAX_RESPONSE_BYTES=1048576
RISK_API_CURSOR_TTL_SECONDS=120

# -------------------------------------------------------------------- budgets
# capture + compute + final check must fit inside the request deadline.
RISK_API_REQUEST_DEADLINE_SECONDS=5.0
RISK_API_CAPTURE_BUDGET_SECONDS=1.0
RISK_API_COMPUTE_BUDGET_SECONDS=3.0
RISK_API_FINAL_CHECK_BUDGET_SECONDS=0.5
RISK_API_MAX_RECAPTURE_ATTEMPTS=1

# ------------------------------------------------------------------ admission
RISK_API_MAX_HEAVY_EXECUTING=4
RISK_API_MAX_HEAVY_QUEUED=16
RISK_API_MAX_CHEAP_CONCURRENT=32
RISK_API_RATE_LIMIT_PER_SECOND=20
RISK_API_RATE_LIMIT_BURST=40
RISK_API_HEAVY_REQUEST_WEIGHT=4
RISK_API_CHEAP_REQUEST_WEIGHT=1
RISK_API_RETRY_AFTER_SECONDS=2

# ------------------------------------------------------------------- database
RISK_API_DB_POOL_SIZE=5
RISK_API_DB_MAX_OVERFLOW=0
RISK_API_DB_POOL_TIMEOUT_SECONDS=0.3
RISK_API_DB_STATEMENT_TIMEOUT_MS=1000

# ---------------------------------------------------------------------- audit
# Leave required=true. A false value permits an unaudited financial response.
RISK_API_AUDIT_REQUIRED=true
RISK_API_AUDIT_BACKEND=jsonl
RISK_API_AUDIT_PATH=./var/audit/api_access_audit.jsonl
RISK_API_AUDIT_COMMIT_TIMEOUT_SECONDS=1.0

# --------------------------------------------------------------------- cursor
# RISK_API_CURSOR_SIGNING_KEY=REPLACE_ME
RISK_API_CURSOR_KEY_ID=cursor-key-1

# -------------------------------------------------------------- observability
# Bind the metrics route to an internal listener in a real deployment.
RISK_API_EXPOSE_INTERNAL_METRICS=true
# Only set this when a trusted proxy owns the header.
# RISK_API_TRUSTED_PROXY_REQUEST_ID_HEADER=X-Request-ID

# ------------------------------------------------------------------ test only
# Must stay false outside local/test; the settings validator enforces it.
RISK_API_FAULTS_ENABLED=false
