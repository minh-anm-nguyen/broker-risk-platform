# Project 08 - ClickHouse Broker Analytics
#
# Copy to .env and fill in. Every value here is validated at startup, and the
# settings module refuses to boot on an unsafe combination rather than
# discovering it in production (see src/analytics/settings.py).

# ---- Deployment -------------------------------------------------------------
P08_ENV=dev
P08_HOST=127.0.0.1
P08_PORT=8008
P08_LOG_LEVEL=INFO

# ---- Kafka ------------------------------------------------------------------
P08_KAFKA_BOOTSTRAP=localhost:9092
P08_KAFKA_TOPIC_ALLOWLIST=broker.deals.v1
P08_KAFKA_GROUP_ID=broker-analytics-v1
# Must stay "none". Resetting to latest after a retention loss turns missing
# money into a clean dashboard, which is what INV08-13 exists to prevent.
P08_KAFKA_AUTO_OFFSET_RESET=none
P08_KAFKA_MAX_BATCH_RECORDS=2000
P08_KAFKA_MAX_ENVELOPE_BYTES=262144

# ---- ClickHouse -------------------------------------------------------------
P08_CH_URL=http://localhost:8123
P08_CH_DATABASE=broker_analytics
# REQUIRED outside dev/test. Name the version this deployment was tested
# against; the placeholder below is rejected (design section 13.1).
P08_CH_SERVER_VERSION_PIN=SET_ME_TO_TESTED_VERSION
# Must stay true until async-insert durability is proven on that pinned
# version (design section 6.1 step 4).
P08_CH_SYNCHRONOUS_INSERT_ACK_REQUIRED=true
P08_CH_MAX_WRITE_CONNECTIONS=4
P08_CH_MAX_READ_QUERIES=16
P08_CH_MAX_QUERY_DURATION_MS=5000
P08_CH_INSERT_DEADLINE_MS=5000

# ---- Control plane ----------------------------------------------------------
# sqlite:///... for the lab, postgresql://... for production.
P08_CONTROL_DSN=postgresql://p08_builder@localhost:5432/broker_platform
P08_CONTROL_STATEMENT_TIMEOUT_MS=5000

# ---- Builds -----------------------------------------------------------------
P08_BUILD_LEASE_SECONDS=300
P08_BUILD_SOURCE_MANIFEST_REQUIRED=true
P08_BUILD_FAIL_ON_MONEY_CURRENCY_UNKNOWN=true
P08_BUILD_FAIL_ON_SEMANTIC_HASH_CONFLICT=true
P08_BUILD_MAX_DEALS=2000000

# ---- Query service ----------------------------------------------------------
P08_QUERY_DEFAULT_PAGE_SIZE=100
P08_QUERY_MAX_PAGE_SIZE=1000
P08_QUERY_MAX_DAY_RANGE=366
P08_QUERY_MAX_IN_FLIGHT=64
P08_QUERY_FRESHNESS_TARGET_SECONDS=300

# ---- Auth -------------------------------------------------------------------
# Distinct tokens: a reader must never hold operator scope. Both are required
# outside dev/test, must differ, and a non-loopback bind needs >= 32 chars.
P08_READER_TOKEN=
P08_OPERATOR_TOKEN=
# Must be durable across restarts: regenerating it invalidates every
# outstanding pagination cursor.
P08_CURSOR_SIGNING_KEY=
P08_CURSOR_SIGNING_KEY_ID=k1

# There is no default tenant. An unmapped source is refused rather than being
# given one, because a default tenant is a cross-tenant leak with extra steps.
# Format: topic:source_id=tenant_id, comma separated.
P08_TENANT_MAP=broker.deals.v1:sim-broker-01=lab-tenant

# Fail reads closed when the audit sink is unavailable.
P08_REQUIRE_AUDIT_FOR_READS=false

# ---- Observability ----------------------------------------------------------
P08_METRICS_REDACT_PII=true
P08_ARTIFACTS_DIR=./artifacts
