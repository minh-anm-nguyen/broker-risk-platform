# Project 07 relay / consumer configuration.
#
# The numeric bounds below are the configuration *proposals* from design
# section 16.2, subject to benchmark -- not measured results. Settings are
# validated at startup (src/outbox/settings.py), so a combination that cannot
# hold is refused rather than discovered during an incident.

# --- store -------------------------------------------------------------------
OUTBOX_STORE_BACKEND=sqlite
OUTBOX_SQLITE_PATH=./outbox.sqlite3
# OUTBOX_PG_DSN=postgresql://outbox_relay@localhost:5432/broker
OUTBOX_RELAY_PG_POOL_MAX=8
OUTBOX_STORAGE_BUDGET_BYTES=1073741824

# --- tenancy -----------------------------------------------------------------
# Assigned server-side from the P03 epoch. Never taken from client metadata.
OUTBOX_SOURCE_ALLOWLIST=sim-broker-01

# --- relay -------------------------------------------------------------------
OUTBOX_RELAY_OWNER=relay-1
OUTBOX_CLAIM_BATCH_SIZE=50
# Must exceed OUTBOX_DELIVERY_DEADLINE_SECONDS, otherwise a standby reclaims
# rows whose produce request is still outstanding and duplicates become the
# normal case rather than a crash-recovery case. Startup refuses it otherwise.
OUTBOX_LEASE_SECONDS=30
OUTBOX_DELIVERY_DEADLINE_SECONDS=10
OUTBOX_MAX_INFLIGHT=64
OUTBOX_MAX_EVENT_WIRE_BYTES=131072
OUTBOX_MAX_ATTEMPTS=12
OUTBOX_BACKOFF_BASE_SECONDS=0.5
OUTBOX_BACKOFF_MAX_SECONDS=60
OUTBOX_BACKOFF_JITTER_RATIO=0.25
OUTBOX_CIRCUIT_FAILURE_THRESHOLD=5
OUTBOX_CIRCUIT_COOLDOWN_SECONDS=15
# max_inflight * max_event_wire_bytes must fit inside this, or the in-flight
# cap is unreachable and backpressure comes from the wrong place.
OUTBOX_PRODUCER_BUFFER_MAX_BYTES=8388608
OUTBOX_POLL_IDLE_SLEEP_SECONDS=0.05

# --- consumer ----------------------------------------------------------------
OUTBOX_CONSUMER_NAME=reference-pg-sink
OUTBOX_CONSUMER_GROUP=reference-pg-sink
OUTBOX_CONSUMER_MAX_POLL_RECORDS=100
# An unlisted schema version is quarantined, never guessed.
OUTBOX_SUPPORTED_SCHEMA_VERSIONS=1

# --- outbox storage pressure (design section 16.4) ---------------------------
# Illustrative policy candidates, not validated thresholds. At fail-closed the
# action is to stop new business imports; truncating PENDING rows to reclaim
# disk is never an option.
OUTBOX_STORAGE_WARN_RATIO=0.80
OUTBOX_STORAGE_THROTTLE_RATIO=0.90
OUTBOX_STORAGE_FAIL_CLOSED_RATIO=0.95
