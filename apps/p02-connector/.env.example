# Project 02 - MT5 Integration Connector. Placeholders only.
#
# No real credential belongs in this file or in any file under version
# control. The connector reads its token from the environment variable named
# by CONNECTOR_TOKEN_ENV and never keeps it in its own settings object, so a
# repr of the configuration is safe to log (design section 9.1, INV-15).

# --- identity and destination -------------------------------------------
CONNECTOR_SOURCE_ID=broker-sim-01
CONNECTOR_SOURCE_KIND=simulator
CONNECTOR_DRIVER=simulator_sync_http
# scheme://host[:port] only. A path is refused, so this can never be pointed
# at a control plane (WF2-A-05). Plain http is permitted for loopback only.
CONNECTOR_BASE_URL=http://127.0.0.1:8000
CONNECTOR_TOKEN_ENV=SIMULATOR_DATA_TOKEN

# The data-plane token itself. Injected by a secret manager in a real
# deployment; the placeholder exists so a local run fails with a clear
# message instead of a 401 storm.
SIMULATOR_DATA_TOKEN=replace-me-with-a-data-plane-token

# --- worker model --------------------------------------------------------
# thread  - enough to prove a blocking call stays off the event loop.
# process - the only mode that can recover from a call that never returns.
CONNECTOR_WORKER_MODE=thread
CONNECTOR_SESSION_WORKERS=1
# Abandoning a hung thread is a leak, not a recovery. Off by default: the
# session stays QUARANTINED and readiness says so (section 5.4).
CONNECTOR_ALLOW_THREAD_ABANDON=false

# --- admission and limits ------------------------------------------------
CONNECTOR_MAX_QUEUE_PENDING=32
CONNECTOR_MAX_CONCURRENT_SCANS=2
CONNECTOR_DEFAULT_PAGE_SIZE=100
CONNECTOR_MAX_PAGE_SIZE=500
CONNECTOR_MAX_RESPONSE_BYTES=1048576
CONNECTOR_MAX_JSON_DEPTH=64
CONNECTOR_MAX_PAGES_PER_SCAN=2500
CONNECTOR_MAX_SCAN_TRACKED_KEYS=200000

# --- time budgets (all monotonic; never the wall clock) ------------------
CONNECTOR_PAGE_TOTAL_DEADLINE_MS=3000
CONNECTOR_QUEUE_WAIT_CAP_MS=500
CONNECTOR_UPSTREAM_READ_TIMEOUT_MS=1500
CONNECTOR_CONNECT_TIMEOUT_MS=500
CONNECTOR_MINIMUM_ATTEMPT_BUDGET_MS=50
CONNECTOR_HUNG_CALL_HARD_LIMIT_MS=10000
CONNECTOR_DRAIN_TIMEOUT_MS=5000
CONNECTOR_HEARTBEAT_INTERVAL_MS=50

# --- retry and breaker ---------------------------------------------------
CONNECTOR_MAX_ATTEMPTS_PER_READ=3
CONNECTOR_MAX_CONNECT_ATTEMPTS=3
CONNECTOR_RETRY_BASE_BACKOFF_MS=100
CONNECTOR_RETRY_MAX_BACKOFF_MS=1000
CONNECTOR_RETRY_AFTER_CAP_MS=2000
CONNECTOR_BREAKER_FAILURE_THRESHOLD=5
CONNECTOR_BREAKER_COOLDOWN_MS=10000

# --- transport policy ----------------------------------------------------
# Never false for an https source: that configuration is refused outright
# rather than warned about (WF2-N-04).
CONNECTOR_TLS_VERIFY=true
CONNECTOR_ALLOW_PLAINTEXT_LOOPBACK=true
# Comma separated. Empty means "whatever BASE_URL names", which is already a
# fixed host because callers cannot supply one.
CONNECTOR_OUTBOUND_ALLOWLIST=

# The connector never injects its own faults. Faults belong to the test
# harness driving the *source* control plane with its own credential
# (section 9.3). Setting this true is a configuration error.
CONNECTOR_ENABLE_FAULT_INJECTION_IN_CONNECTOR=false
