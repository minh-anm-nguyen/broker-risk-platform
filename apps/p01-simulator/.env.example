# MT5 Broker Simulator configuration. Copy to .env and edit.
#
# Placeholders only: this file must never contain a real secret, and the
# repository has no mechanism that would need one (the data is synthetic).

# ---- Deployment ------------------------------------------------------------
SIM_ENV=dev
# Loopback by default. Binding anywhere else requires the three secrets below;
# startup fails closed otherwise rather than exposing an unauthenticated
# control plane (WF-108, WF-122).
SIM_HOST=127.0.0.1
SIM_PORT=8001

# ---- Storage ---------------------------------------------------------------
SIM_DB_PATH=./data/simulator.db
SIM_SQLITE_SYNCHRONOUS=FULL
SIM_SQLITE_BUSY_TIMEOUT_MS=5000
SIM_READ_POOL_SIZE=8
# Reads the whole database, so it is off by default to protect the 30 s
# restart-readiness target (section 4.3).
SIM_INTEGRITY_CHECK_ON_START=false

# ---- Auth ------------------------------------------------------------------
# Required for any non-loopback bind, and they must differ from each other:
# one shared token would make the data plane an admin plane.
SIM_DATA_TOKEN=replace-with-a-random-data-plane-token
SIM_ADMIN_TOKEN=replace-with-a-different-random-admin-token

# Must be durable. Regenerating it on each restart would silently invalidate
# every outstanding cursor (section 4.2).
SIM_CURSOR_SIGNING_KEY=replace-with-a-random-32-byte-secret
SIM_CURSOR_SIGNING_KEY_ID=k1
# During rotation, keep the previous key for at least one snapshot TTL so
# cursors already in flight still verify.
# SIM_CURSOR_SIGNING_KEY_PREVIOUS=
# SIM_CURSOR_SIGNING_KEY_PREVIOUS_ID=

# ---- Bounded resources (section 9.3) ---------------------------------------
# There is no "unlimited" value for any of these.
SIM_DEFAULT_PAGE_SIZE=100
SIM_MAX_PAGE_SIZE=500
SIM_MAX_REQUEST_BODY_BYTES=262144
SIM_MAX_PENDING_EVENTS=10000
SIM_MAX_DATA_REQUESTS_IN_FLIGHT=128
SIM_MAX_ACTIVE_SNAPSHOTS=100
SIM_SNAPSHOT_TTL_SEC=900
SIM_MAX_FAULT_DELAY_MS=30000
SIM_MAX_FAULT_RULES=100
SIM_MAX_DEALS_PER_RUN=1000000
SIM_MAX_ADVANCE_EVENTS=100000
SIM_WRITER_BATCH_SIZE=500
# How long admission may wait for an in-flight slot before refusing. Waiting
# without a deadline is how a service dies quietly.
SIM_ADMISSION_TIMEOUT_MS=250
SIM_REQUEST_DEADLINE_MS=30000

# ---- Rate limiting ---------------------------------------------------------
SIM_RATE_LIMIT_ENABLED=true
SIM_RATE_LIMIT_RPS=500
SIM_RATE_LIMIT_BURST=1000

# ---- Clock -----------------------------------------------------------------
# Business time advances by this much per event. Nothing reads the host clock
# for a business decision.
SIM_VIRTUAL_TIME_STEP_MS=1000
SIM_MARK_STALE_AFTER_MS=60000
SIM_CURSOR_CLOCK_SKEW_TOLERANCE_SEC=60

# ---- Observability ---------------------------------------------------------
SIM_METRICS_ENABLED=true
SIM_LOG_LEVEL=INFO
SIM_LOG_FORMAT=json

# ---- Test-only hooks -------------------------------------------------------
# Deterministic crash points. With failpoint_mode=kill the process terminates
# hard when one fires, so never set these in a deployment anything depends on.
# Valid names: just_before_commit, just_after_commit, storage_full,
# storage_readonly. A misspelled name is refused at startup rather than
# silently injecting nothing (WF-119).
# SIM_FAILPOINT=
# SIM_FAILPOINT_AT_SEQ=0
# SIM_FAILPOINT_MODE=kill
