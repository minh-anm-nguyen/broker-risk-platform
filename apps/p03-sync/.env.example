# Project 03 - Trading Data Synchronization
# Copy to .env and fill in. Never commit real secrets.

# Runtime DSN used by the service and the CLI (asyncpg driver).
SYNC_DATABASE_URL=postgresql+asyncpg://postgres@localhost:55432/trading_sync

# DSN used by the integration/crash test suites. When unset, those suites are
# SKIPPED and their what-if cases are reported BLOCKED_ENVIRONMENT (never PASS).
SYNC_TEST_DATABASE_URL=postgresql+asyncpg://postgres@localhost:55432/trading_sync_test

# Logical source identity. Never taken from client input (AS-01).
SYNC_SOURCE__SOURCE_ID=sim_local
SYNC_SOURCE__KIND=simulator
SYNC_SOURCE__CONNECTOR_ENDPOINT=http://localhost:8080

# Test-only kill-point barriers (K00..K16). MUST stay false outside tests.
SYNC_ENABLE_KILLPOINTS=false
