# Project 04 - Snapshot Reconciliation & Recovery
# Copy to .env and adjust. Every bound here is deliberate: there is no
# "unlimited" mode (SYSTEM_DESIGN section 8.1, FR04-12).

RECON_ENV=dev
RECON_WORKER_ID=recon-worker-1

# --- storage -----------------------------------------------------------
# The reference deployment is PostgreSQL (database/migrations/0001_*.sql).
# This build runs on SQLite in WAL mode; see README for what that changes.
RECON_DB_PATH=./data/recon.db
RECON_SQLITE_SYNCHRONOUS=FULL
RECON_SQLITE_BUSY_TIMEOUT_MS=5000
RECON_STATEMENT_TIMEOUT_MS=30000

# --- source (Project 01 simulator) -------------------------------------
RECON_SOURCE_BASE_URL=http://127.0.0.1:8001
RECON_SOURCE_ID=sim_local
# Required outside local runs. Never commit a real token.
RECON_SOURCE_DATA_TOKEN=
RECON_SOURCE_MAX_PAGE_SIZE=500
RECON_SOURCE_SNAPSHOT_TTL_S=900
RECON_SOURCE_REQUEST_TIMEOUT_S=10
RECON_SOURCE_MAX_RETRIES=3

# --- run bounds --------------------------------------------------------
RECON_MAX_PAGES_PER_RUN=10000
RECON_MAX_ITEMS_PER_RUN=2000000
RECON_RUN_DEADLINE_S=1800
RECON_MAX_CONCURRENT_RUNS=2
RECON_MAX_CONCURRENT_REPAIRS_PER_SOURCE=1
RECON_LEASE_TTL_S=120

# --- safety policy -----------------------------------------------------
# 20% and 300s are the design's starting proposals, to be tuned against a
# measured environment. They are hashed into policy_hash, so changing one
# makes earlier runs visibly incomparable rather than silently so.
RECON_MASS_DRIFT_FRACTION=0.20
RECON_MASS_DRIFT_MIN_ENTITIES=10
RECON_LARGE_COUNT_DROP_FRACTION=0.50
RECON_EVIDENCE_MAX_AGE_S=300
RECON_PLAN_TTL_S=3600

# Approval cannot be disabled in prod, and auto-dispatch is refused there.
RECON_APPROVAL_REQUIRED=true
RECON_ALLOW_AUTO_DISPATCH=false
RECON_REQUIRE_DISTINCT_APPROVER=true
# P1: touches immutable deal history. Off by default.
RECON_ALLOW_DEAL_BACKFILL=false

# --- cross-entity capability -------------------------------------------
# Cannot exceed what the source actually supports: asking for T2 without a
# tested global cut resolves back to T1 (section 0.4).
RECON_CROSS_ENTITY_TIER=T1
RECON_CROSS_ENTITY_GRACE_S=60

# --- retention ---------------------------------------------------------
RECON_EVIDENCE_RETENTION_S=604800
RECON_ARTIFACTS_DIR=./artifacts
